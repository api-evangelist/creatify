{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creatify AI Avatar Voices API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-ID",
      "value": "{{X-API-ID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all available voices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.creatify.ai/api/voices/"
          },
          "docs": "Get all available voices"
        },
        {
          "info": {
            "name": "Get voices with pagination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.creatify.ai/api/voices/paginated/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get voices with pagination"
        }
      ]
    }
  ],
  "bundled": true
}